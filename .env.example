# UrbanScope Environment Configuration
# Copy this file to `.env` and fill in your credentials:
#   cp .env.example .env

# Server Binding (Optional)
HOST=127.0.0.1
PORT=8000

# JWT Signing Secret (Change in production)
URBANSCOPE_SECRET_KEY=urbanscope-real-estate-secret-key-2026-production

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID -> Application type: "Web application"
# 3. Add Authorized JavaScript origins:
#      http://127.0.0.1:8000
#      http://localhost:8000
# 4. Paste your Client ID below (ends with .apps.googleusercontent.com):
GOOGLE_CLIENT_ID=
