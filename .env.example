# ─────────────────────────────────────────────────────────────
# UrbanScope environment — copy to `.env` and fill in values.
#   Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./urbanscope.db"

# Public base URL of the site (used for the Google OAuth redirect URI)
APP_URL="http://localhost:3000"

# Long random string used to sign session cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# The single admin account. Seeded on first run; password can be changed in Admin → Settings.
ADMIN_EMAIL="gianticaya@gmail.com"
ADMIN_INITIAL_PASSWORD="urbanscope"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:  http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
